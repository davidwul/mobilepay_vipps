<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_mailchimp_accounts_form" model="ir.ui.view">
            <field name="name">mailchimp.account.form</field>
            <field name="model">mailchimp.account</field>
            <field name="arch" type="xml">
                <form string="MailChimp Accounts">
                    <header>
                        <button name="test_connection" string="Test Connection"
                                type="object" class="btn-success"/>
                        <button type="object" name="refresh_lists" string="Fetch audiences" class="btn-primary" icon="fa-refresh"/>
                        <button type="object" name="fetch_campaigns" string="Fetch campaigns" class="btn-primary" icon="fa-refresh"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label class="oe_edit_only" for="name" string="Account Name"/>
                            <h1>
                                <field name="name" placeholder="Account Name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Authentication">
                                <field name="server_prefix"/>
                                <field name="api_key"/>
                            </group>
                        </group>
                        <group string='MailChimp Tutorial'
                               attrs="{'invisible': [('api_key', '!=', False)]}">
                            <ul>
                                <li>
                                    <b>
                                        Go to
                                        <a href='https://mailchimp.com/help/about-api-keys/' target='_blank'>MailChimp
                                            Website
                                        </a>
                                        to create or retrive API Key
                                    </b>
                                </li>
                            </ul>
                        </group>
                        <notebook>
                            <page name="lists" string="Audiences">
                                <field name="list_ids">
                                    <tree create="false">
                                        <field name="name" string="Audience"/>
                                        <field name="mailchimp_list_id"/>
                                        <field name="contact_nbr"/>
                                        <button name="mailchimp_fetch_members" attrs="{'invisible': [('mailchimp_list_id','=', False)]}"
                                                string="Refresh contacts" type="object" icon="fa-refresh"/>
                                    </tree>
                                </field>
                            </page>
                            <page name="campaign" string="Campaigns">
                                <group>
                                    <field name="last_campaign_fetch"/>
                                </group>
                                <field name="campaign_ids" nolabel="1" readonly="1"/>
                            </page>
                            <page name="settings" string="Settings">
                                <p>Export Contacts and Fetch Campaigns as defined in scheduled actions.
                                            <div class="mt16">
                                                <p>
                                                    <button name="get_mailchimp_scheduled_actions" icon="fa-arrow-right" type="object" string="Scheduled Actions" class="btn-link"/>
                                                </p>
                                            </div>
                                        </p>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_mailchimp_accounts_tree" model="ir.ui.view">
            <field name="name">mailchimp.accounts.tree</field>
            <field name="model">mailchimp.account</field>
            <field name="arch" type="xml">
                <tree string="MailChimp Account">
                    <field name="name"/>
                    <field name="api_key"/>
                </tree>
            </field>
        </record>

        <record id="action_mailchimp_accounts" model="ir.actions.act_window">
            <field name="name">MailChimp Accounts</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mailchimp.account</field>
            <field name="view_mode">tree,form</field>
            <field name="context"></field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new MailChimp Account.
                </p>
                <p>
                    Accounts allows you to manage all MailChimp operations from here.
                </p>
            </field>
        </record>

        <record model="ir.actions.server" id="refresh_all_campaigns">
            <field name="name">Fetch Campaigns</field>
            <field name="model_id" ref="model_mailchimp_account"/>
            <field name="state">code</field>
            <field name="code">
                for account in model.search([]):
                    account.fetch_campaigns()
            </field>
        </record>

        <menuitem id="menu_mailchimp_root" name="MailChimp" parent="mass_mailing.mass_mailing_menu_root"
                  sequence="3" groups="mass_mailing.group_mass_mailing_user"/>

        <menuitem name="Accounts" parent="menu_mailchimp_root"
                  action="action_mailchimp_accounts" id="menu_action_mailchimp_accounts"
                  sequence="10"/>
        <menuitem id="menu_fetch_campaigns" action="refresh_all_campaigns" parent="menu_mailchimp_root"
                  sequence="40"/>
    </data>
</odoo>
