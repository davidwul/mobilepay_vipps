<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_mail_mass_mailing_form" model="ir.ui.view">
            <field name="name">mail.mass_mailing.form</field>
            <field name="model">mailing.mailing</field>
            <field
        name="inherit_id"
        ref="mass_mailing.view_mail_mass_mailing_form"
      />
            <field name="arch" type="xml">
                <header position="after">
                    <div
            class="alert alert-danger text-center"
            role="alert"
            invisible="state != 'draft' or not mailchimp_id"
          >
                        <p>This is a MailChimp campaign. <strong
              >All changes made here won't have any effect</strong>. Please go on MailChimp if you want to edit it.</p>
                    </div>
                </header>
                <div name="button_box">
                    <button
            name="action_refresh_mailchimp"
            type="object"
            icon="fa-refresh"
            class="oe_stat_button"
            string="Refresh (MailChimp)"
            invisible="not mailchimp_id"
          />
                    <button
            name="action_open_mailchimp_backend"
            type="object"
            icon="fa-external-link"
            class="oe_stat_button"
            string="Open in MailChimp"
            invisible="not mailchimp_id"
          />
                </div>
                <!-- Replace recipients for MailChimp mailings -->
                <div name="mailing_model_id_container" position="attributes">
                    <attribute name="invisible">mailchimp_id</attribute>
                </div>
                <label for="mailing_model_id" position="attributes">
                    <attribute name="invisible">mailchimp_id</attribute>
                </label>
                <field name="contact_list_ids" position="attributes">
                    <attribute
            name="readonly"
          >state in ('sending', 'done')</attribute>
                </field>
                <div name="mailing_model_id_container" position="after">
                    <label
            for="mailchimp_recipients"
            invisible="not mailchimp_id"
          />
                    <div
            name="mailchimp_recipients_container"
            invisible="not mailchimp_id"
          >
                        <div class="d-flex">
                            <p
                class="oe_inline"
              >Number of selected contacts:</p>
                            <field
                name="mailchimp_recipients_count"
                class="ml-1"
              />
                        </div>
                        <field name="mailchimp_recipients" />
                    </div>
                </div>
                <!-- Add MailChimp fields -->
                <page name="settings" position="after">
                    <page
            name="mailchimp"
            string="MailChimp"
            invisible="not mailchimp_id"
          >
                        <group>
                            <field name="mailchimp_id" invisible="1" />
                            <field
                name="last_report_import_date"
                readonly="1"
              />
                            <field
                name="mailchimp_archive_url"
                widget="url"
                readonly="1"
              />
                            <field name="mailchimp_template_id" readonly="1" />
                            <field name="sent_date" />
                        </group>
                    </page>
                </page>
            </field>
        </record>

        <record id="view_mail_mass_mailing_kanban" model="ir.ui.view">
            <field name="name">mail.mass_mailing.kanban</field>
            <field name="model">mailing.mailing</field>
            <field
        name="inherit_id"
        ref="mass_mailing.view_mail_mass_mailing_kanban"
      />
            <field name="arch" type="xml">
                <field name="color" position="after">
                    <field name="mailchimp_id" />
                </field>
                <field
          name="user_id"
          position="before"
        >
                    <t t-if="record.mailchimp_id.raw_value">
                        <span
              class="badge badge-primary oe_inline o_enterprise_label"
            >
                            MailChimp
                        </span>
                    </t>
                </field>
            </field>
        </record>

        <record model="ir.actions.server" id="multi_refresh_action">
            <field name="name">Refresh MailChimp Campaigns</field>
            <field name="model_id" ref="model_mailing_mailing" />
            <field name="binding_model_id" ref="model_mailing_mailing" />
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.multi_refresh_mailchimp()</field>
        </record>
    </data>
</odoo>
