<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_mail_mass_mailing_list_kanban" model="ir.ui.view">
            <field name="name">mailing.list.mailchimp.kanban</field>
            <field name="model">mailing.list</field>
            <field
        name="inherit_id"
        ref="mass_mailing.mailing_list_view_kanban"
      />
            <field name="arch" type="xml">
                <field name="contact_count" position="after">
                    <field name="mailchimp_list_id" />
                </field>
                <xpath
          expr="//div[hasclass('oe_kanban_content')]/div[last()]"
          position="after"
        >
                    <t t-if="record.mailchimp_list_id.raw_value">
                        <span
              class="badge badge-primary oe_inline o_enterprise_label"
            >
                            MailChimp
                        </span>
                    </t>
                </xpath>
            </field>
        </record>
        <record model="ir.ui.view" id="mailing_list_form">
            <field name="name">mailing.list.mailchimp.form</field>
            <field name="model">mailing.list</field>
            <field
        name="inherit_id"
        ref="mass_mailing.mailing_list_view_form"
      />
            <field name="arch" type="xml">
                <sheet position="before">
                    <header>
                        <field name="mailchimp_list_id" invisible="1" />
                        <button
              name="mailchimp_fetch_members"
              type="object"
              string="Fetch Members from MailChimp"
              class="btn-primary"
              invisible="not mailchimp_list_id"
            />
                        <button
              name="mailchimp_update_merge_fields"
              type="object"
              string="Update Merge Fields"
              class="btn-primary"
              invisible="not mailchimp_list_id"
            />
                    </header>
                </sheet>
                <xpath expr="//group[last()]" position="after">
                    <field name="mailchimp_list_id" invisible="1" />
                    <notebook invisible="not mailchimp_list_id">
                        <page string="Merge Fields">
                            <field name="mailchimp_merge_field_ids">
                                <tree editable="bottom" create="0">
                                    <field
                    name="display_order"
                    widget="handle"
                  />
                                    <field name="name" />
                                    <field name="tag" />
                                    <field name="type" readonly="1" />
                                    <field name="date_format" readonly="1" />
                                    <field name="required" />
                                    <field name="public" />
                                    <field
                    name="value"
                    placeholder="contact.xxx"
                  />
                                    <field name="default_value" />
                                </tree>
                            </field>
                        </page>
                        <page string="MailChimp Settings">
                            <group>
                                <field name="mailchimp_auto_export_member" />
                            </group>
                            <group>
                                <field name="mailchimp_import_tags" />
                                <field name="mailchimp_export_tags" />
                            </group>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
